#!/bin/sh
set -eu
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$PROJECT_DIR/.venv/bin/python" ] && "$PROJECT_DIR/.venv/bin/python" -c 'import cv2, numpy' >/dev/null 2>&1; then
  PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"
else
  PYTHON_BIN=python3
fi
CALIBRATOR_PYTHONPATH="$PROJECT_DIR/src"
if [ -d "$PROJECT_DIR/.remote-deps" ]; then
  CALIBRATOR_PYTHONPATH="$PROJECT_DIR/.remote-deps:$CALIBRATOR_PYTHONPATH"
fi
PYTHONPATH="$CALIBRATOR_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON_BIN" -m stereo_calibrator.cli "$@"
